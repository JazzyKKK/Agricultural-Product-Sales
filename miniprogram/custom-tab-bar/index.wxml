<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar">
  <view class="tab-item {{selected === index ? 'active' : ''}}"
        wx:for="{{list}}" wx:key="pagePath"
        data-index="{{index}}" bindtap="onTap">
    <text class="tab-icon">{{item.icon}}</text>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
