/* pages/customerDetail/customerDetail.wxss */
.page-customer-detail {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部信息卡 */
.info-hero {
  background: linear-gradient(135deg, #7BC47F 0%, #5BA85F 100%);
  padding: 48rpx 40rpx 40rpx;
  color: #fff;
  border-radius: 0 0 32rpx 32rpx;
}

.info-name {
  font-size: 40rpx;
  font-weight: 700;
}

.info-phone {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  opacity: 0.95;
  margin-top: 16rpx;
}

.phone-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.info-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.info-cell {
  flex: 1;
}

.info-num {
  font-size: 44rpx;
  font-weight: 700;
}

.info-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.info-divider {
  width: 2rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 备注 */
.remark-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 操作按钮 */
.action-row {
  display: flex;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
}

.action-btn + .action-btn {
  margin-left: 24rpx;
}

/* 消费记录项 */
.sale-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.sale-item:last-child {
  border-bottom: none;
}

.sale-left {
  flex: 1;
  min-width: 0;
}

.sale-no {
  font-size: 28rpx;
  font-weight: 500;
}

.sale-meta {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.sale-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--danger);
}
