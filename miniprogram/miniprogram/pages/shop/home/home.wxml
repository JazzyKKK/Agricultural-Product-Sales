<!-- pages/shop/home/home.wxml 商城首页 -->
<view class="page-home">
  <!-- 顶部欢迎区 -->
  <view class="hero">
    <view class="hero-title">阳光玫瑰葡萄园</view>
    <view class="hero-sub">现摘太白香印葡萄 · 手工葡萄酒</view>
  </view>

  <!-- 葡萄园横幅图 -->
  <view class="banner-wrap">
    <image class="banner-img" src="/images/grape-banner-real.jpg" mode="aspectFill" />
    <view class="banner-mask"></view>
    <view class="banner-text">
      <view class="banner-title">产地直发 · 自然成熟</view>
      <view class="banner-desc">太白香印葡萄种植园</view>
    </view>
  </view>

  <!-- 葡萄园地址介绍 -->
  <view class="farm-intro card">
    <view class="farm-intro-head">
      <text class="farm-icon">📍</text>
      <text class="farm-title">葡萄园地址</text>
    </view>
    <view class="farm-content">
      <view class="farm-row">
        <text class="farm-label">园区地址</text>
        <text class="farm-value">陕西省宝鸡市太白县桃川镇阳光玫瑰葡萄种植园</text>
      </view>
      <view class="farm-row">
        <text class="farm-label">葡萄最佳品尝日期</text>
        <text class="farm-value">9 月 - 12 月</text>
      </view>
      <view class="farm-row">
        <text class="farm-label">葡萄酒</text>
        <text class="farm-value">全年供应</text>
      </view>
      <view class="farm-row">
        <text class="farm-label">园区特色</text>
        <text class="farm-value">露天种植，日照充足，自然成熟，无催熟剂</text>
      </view>
      <view class="farm-contact" bindtap="onContact">
        <text class="farm-contact-icon">📞</text>
        <text class="farm-contact-text">联系我们：{{phone}}</text>
        <text class="farm-contact-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="container">
    <!-- 搜索框 -->
    <view class="search-bar">
      <input class="search-input" placeholder="搜索商品名称" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
    </view>

    <!-- 分类快捷入口 -->
    <view class="quick-cat">
      <view class="quick-cat-item" data-cat="葡萄" bindtap="goCategory">
        <view class="quick-cat-icon grape">🍇</view>
        <text>葡萄</text>
      </view>
      <view class="quick-cat-item" data-cat="葡萄酒" bindtap="goCategory">
        <view class="quick-cat-icon wine">🍷</view>
        <text>葡萄酒</text>
      </view>
    </view>

    <!-- 全部商品 -->
    <view class="card">
      <view class="card-title">
        全部商品
        <text class="more" bindtap="goCategory">查看分类 ›</text>
      </view>

      <view wx:if="{{!loading && filtered.length === 0}}" class="empty">
        <text class="empty-icon">🍇</text>
        暂无商品
      </view>

      <view class="product-grid">
        <view class="product-card" wx:for="{{filtered}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
          <view class="product-image-wrap">
            <image wx:if="{{item.image}}" class="product-image" src="{{item.image}}" mode="aspectFill" />
            <view wx:else class="product-image placeholder">{{item.category === '葡萄酒' ? '🍷' : '🍇'}}</view>
            <view wx:if="{{item.stock <= 0}}" class="sold-out">已售罄</view>
          </view>
          <view class="product-info">
            <view class="product-name">{{item.name}}</view>
            <view class="product-tags">
              <text class="tag {{item.category === '葡萄酒' ? 'tag-wine' : 'tag-grape'}}">{{item.category}}</text>
            </view>
            <view class="product-price-row">
              <text class="price">￥{{item.priceText}}</text>
              <text class="product-unit">/{{item.unit}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
