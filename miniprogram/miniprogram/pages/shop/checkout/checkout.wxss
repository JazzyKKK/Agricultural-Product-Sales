/* pages/shop/checkout/checkout.wxss 确认订单 */
.page-checkout {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.ck-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.ck-item:last-child {
  border-bottom: none;
}

.ck-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F2F5;
}

.ck-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.ck-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.ck-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ck-spec {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.ck-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.ck-qty {
  margin-left: 12rpx;
}

.ck-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.submit-total {
  flex: 1;
  font-size: 28rpx;
}

.submit-total .price {
  font-size: 36rpx;
  margin-left: 8rpx;
}

.submit-btn {
  width: 280rpx;
}

.btn-disabled {
  opacity: 0.6;
}
