<!-- pages/shop/orders/orders.wxml 我的订单 -->
<view class="page-orders">
  <!-- 状态 tab -->
  <view class="status-tabs">
    <view class="status-tab {{activeKey === item.key ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onTabTap">
      {{item.label}}
    </view>
  </view>

  <view class="container">
    <view wx:if="{{!loading && orders.length === 0}}" class="empty">
      <text class="empty-icon">📜</text>
      暂无订单
    </view>

    <view class="order-card" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDetail">
      <view class="order-head">
        <text class="order-no">订单号 {{item.orderNo}}</text>
        <text class="order-status {{statusMap[item.status].cls}}">{{statusMap[item.status].label}}</text>
      </view>
      <view class="order-summary">{{item.summary}}</view>
      <view class="order-foot">
        <text class="order-time">{{item.timeText}}</text>
        <text class="order-total">￥{{item.totalText}}</text>
      </view>
      <view wx:if="{{item.status === 'pending'}}" class="order-action">
        <text class="text-primary">去支付 ›</text>
      </view>
    </view>
  </view>
</view>
