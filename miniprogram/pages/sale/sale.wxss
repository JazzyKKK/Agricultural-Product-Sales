/* pages/sale/sale.wxss */
.page-sale {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 客户 */
.cust-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.cust-placeholder {
  color: var(--text-light);
}

.arrow {
  color: var(--text-light);
  font-size: 36rpx;
}

.cust-selected {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.cust-name {
  font-size: 32rpx;
  font-weight: 600;
}

.cust-phone {
  font-size: 24rpx;
  color: var(--text-light);
  margin-left: 16rpx;
}

.cust-clear {
  color: var(--primary);
  font-size: 26rpx;
}

.walkin-tip {
  margin-top: 16rpx;
  border-top: 2rpx dashed var(--border);
  padding-top: 16rpx;
}

.walkin-btn {
  color: var(--accent);
  font-size: 26rpx;
}

/* 明细项 */
.item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.item:last-child {
  border-bottom: none;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.item-name .tag {
  margin-left: 12rpx;
}

.item-del {
  font-size: 24rpx;
  color: var(--danger);
}

.item-spec {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 8rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.field {
  display: flex;
  align-items: center;
}

.field-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.field-input {
  width: 120rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.field-unit {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 8rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  font-size: 36rpx;
  color: var(--primary);
}

.step-btn:first-child {
  border-radius: 12rpx 0 0 12rpx;
}

.step-btn:last-child {
  border-radius: 0 12rpx 12rpx 0;
}

.step-input {
  width: 90rpx;
  height: 52rpx;
  border-top: 2rpx solid var(--border);
  border-bottom: 2rpx solid var(--border);
  text-align: center;
  font-size: 28rpx;
}

.item-sub {
  text-align: right;
  font-size: 26rpx;
  color: var(--danger);
  margin-top: 12rpx;
  font-weight: 600;
}

/* 支付方式 */
.pay-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.pay-item {
  padding: 16rpx 36rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.pay-item.active {
  background: var(--primary-light);
  border-color: var(--primary);
  color: var(--primary-dark);
  font-weight: 600;
}

/* 备注 */
.remark-input {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 底部提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 50;
}

.submit-total {
  flex: 1;
}

.submit-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-light);
}

.submit-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--danger);
}

.submit-btn {
  width: 280rpx;
  margin-left: 24rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 80;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 90;
}

.sheet-show {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 2rpx solid var(--border);
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 32rpx;
  color: var(--text-light);
  padding: 0 8rpx;
}

.sheet-search {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  background: var(--bg);
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.sheet-add {
  color: var(--primary);
  font-size: 28rpx;
  white-space: nowrap;
}

.sheet-body {
  max-height: 60vh;
  padding: 0 28rpx 28rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.sheet-item-name {
  font-size: 30rpx;
  font-weight: 500;
}

.sheet-item-phone {
  font-size: 24rpx;
  color: var(--text-light);
  margin-left: 16rpx;
}

.sheet-item-stat {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 商品分类标签 */
.cat-tabs {
  display: flex;
  padding: 0 28rpx;
  gap: 16rpx;
  border-bottom: 2rpx solid var(--border);
}

.cat-tab {
  padding: 20rpx 0;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.cat-tab.active {
  color: var(--primary);
  font-weight: 600;
}

.cat-tab.active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.prod-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.prod-name {
  font-size: 30rpx;
  font-weight: 500;
  display: block;
}

.prod-spec {
  font-size: 24rpx;
  color: var(--text-light);
  margin-top: 6rpx;
  display: block;
}

.prod-price {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 600;
}
