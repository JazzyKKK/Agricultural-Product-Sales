/* pages/shop/category/category.wxss 分类页 */
.page-category {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.cat-header {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  padding: 24rpx 0 16rpx;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.product-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-image.placeholder {
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.sold-out {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-tags {
  margin: 8rpx 0;
  display: flex;
  align-items: center;
}

.product-spec {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 8rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.product-price-row .price {
  font-size: 32rpx;
}

.product-unit {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 4rpx;
}

.product-stock {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}
