/* pages/shop/home/home.wxss 商城首页 */
.page-home {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 顶部欢迎区 */
.hero {
  background: linear-gradient(135deg, #7BC47F 0%, #5BA85F 100%);
  padding: 48rpx 40rpx 40rpx;
  color: #fff;
  border-radius: 0 0 32rpx 32rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

/* 葡萄园横幅图 */
.banner-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  margin: -20rpx 0 24rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 100%);
}

.banner-text {
  position: absolute;
  left: 32rpx;
  bottom: 32rpx;
  color: #fff;
}

.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

.banner-desc {
  font-size: 24rpx;
  opacity: 0.95;
  margin-top: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* 葡萄园地址介绍 */
.farm-intro {
  margin-bottom: 24rpx;
}

.farm-intro-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.farm-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.farm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.farm-content {
  padding-top: 8rpx;
}

.farm-row {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.farm-row:last-of-type {
  border-bottom: none;
}

.farm-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.farm-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.farm-contact {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.farm-contact-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.farm-contact-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--primary-dark);
  font-weight: 500;
}

.farm-contact-arrow {
  font-size: 28rpx;
  color: var(--primary);
}

/* 搜索框 */
.search-bar {
  margin-bottom: 24rpx;
}

.search-input {
  background: #fff;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 分类快捷入口 */
.quick-cat {
  display: flex;
  margin-bottom: 24rpx;
}

.quick-cat-item {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.quick-cat-item text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.quick-cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.quick-cat-icon.grape { background: var(--primary-light); }

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.product-image-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.product-image.placeholder {
  background: #F0F2F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.sold-out {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-tags {
  margin: 8rpx 0;
}

.product-price-row {
  display: flex;
  align-items: baseline;
}

.product-price-row .price {
  font-size: 32rpx;
}

.product-unit {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 4rpx;
}
