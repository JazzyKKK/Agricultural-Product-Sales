<!-- pages/shop/checkout/checkout.wxml 确认订单 -->
<view class="page-checkout">
  <view class="container">
    <!-- 商品清单 -->
    <view class="card">
      <view class="card-title">商品清单</view>
      <view class="ck-item" wx:for="{{items}}" wx:key="productId">
        <image wx:if="{{item.image}}" class="ck-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="ck-img placeholder">🍇</view>
        <view class="ck-info">
          <view class="ck-name">{{item.name}}</view>
          <view wx:if="{{item.spec}}" class="ck-spec">{{item.spec}}</view>
          <view class="ck-price-row">
            <text class="price">￥{{item.priceText}}</text>
            <text class="ck-qty">×{{item.qty}}</text>
          </view>
        </view>
        <view class="ck-subtotal">￥{{item.subtotalText}}</view>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="card">
      <view class="card-title">收货信息</view>
      <view class="form-group">
        <text class="form-label">姓名</text>
        <input class="form-input" placeholder="收货人姓名" value="{{customerName}}" bindinput="onNameInput" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" placeholder="联系电话" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="form-group">
        <text class="form-label">地址</text>
        <textarea class="form-input" placeholder="详细收货地址" value="{{address}}" bindinput="onAddressInput" auto-height />
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{remark}}" bindinput="onRemarkInput" />
      </view>
    </view>
  </view>

  <!-- 底部提交栏 -->
  <view class="submit-bar">
    <view class="submit-total">
      合计 <text class="price">￥{{totalText}}</text>
    </view>
    <view class="btn btn-primary submit-btn {{submitting ? 'btn-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中...' : '提交订单'}}
    </view>
  </view>
</view>
