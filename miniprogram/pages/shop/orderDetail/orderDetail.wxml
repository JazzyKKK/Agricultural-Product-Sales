<!-- pages/shop/orderDetail/orderDetail.wxml 订单详情 -->
<view class="page-order-detail" wx:if="{{order}}">
  <!-- 状态卡 -->
  <view class="status-card {{statusCls}}">
    <view class="status-big">{{statusLabel}}</view>
    <view class="status-meta">订单号 {{order.orderNo}}</view>
    <view class="status-meta">下单时间 {{order.timeText}}</view>
  </view>

  <view class="container">
    <!-- 收货信息 -->
    <view class="card">
      <view class="card-title">收货信息</view>
      <view class="info-row"><text class="info-label">姓名</text><text>{{order.customerName}}</text></view>
      <view class="info-row"><text class="info-label">电话</text><text class="info-link" bindtap="onCall">{{order.phone}}</text></view>
      <view class="info-row"><text class="info-label">地址</text><text>{{order.address}}</text></view>
      <view wx:if="{{order.remark}}" class="info-row"><text class="info-label">备注</text><text>{{order.remark}}</text></view>
    </view>

    <!-- 物流信息（已发货后展示） -->
    <view class="card" wx:if="{{order.trackingNumber}}">
      <view class="card-title">物流信息</view>
      <view class="info-row"><text class="info-label">快递公司</text><text>{{order.shippingCompanyName}}</text></view>
      <view class="info-row">
        <text class="info-label">快递单号</text>
        <text class="info-link" bindtap="onCopyTracking">{{order.trackingNumber}}（点击复制）</text>
      </view>
    </view>

    <!-- 商品明细 -->
    <view class="card">
      <view class="card-title">商品明细</view>
      <view class="od-item" wx:for="{{items}}" wx:key="productId">
        <image wx:if="{{item.image}}" class="od-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="od-img placeholder">🍇</view>
        <view class="od-info">
          <view class="od-name">{{item.name}}</view>
          <view wx:if="{{item.spec}}" class="od-spec">{{item.spec}}</view>
          <view class="od-price-row">
            <text class="price">￥{{item.priceText}}</text>
            <text class="od-qty">×{{item.qty}}</text>
          </view>
        </view>
        <view class="od-subtotal">￥{{item.subtotalText}}</view>
      </view>
    </view>

    <!-- 金额 -->
    <view class="card">
      <view class="amount-row">
        <text>商品总额</text>
        <text class="price">￥{{totalText}}</text>
      </view>
      <view class="amount-row amount-total">
        <text>实付</text>
        <text class="price">￥{{totalText}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏（按状态） -->
  <view class="od-bottom" wx:if="{{order.status === 'pending' || order.status === 'shipped'}}">
    <view wx:if="{{order.status === 'pending'}}" class="btn btn-outline od-btn" bindtap="onCancel">取消订单</view>
    <view wx:if="{{order.status === 'pending'}}" class="btn btn-primary od-btn" bindtap="onContactSeller">联系商家付款</view>
    <view wx:if="{{order.status === 'shipped'}}" class="btn btn-primary od-btn" bindtap="onConfirm">确认收货</view>
  </view>

  <view wx:if="{{order.status === 'paid'}}" class="od-tip">等待商家发货</view>
</view>

<view wx:elif="{{!loading}}" class="empty">
  <text class="empty-icon">📜</text>
  订单不存在
</view>
