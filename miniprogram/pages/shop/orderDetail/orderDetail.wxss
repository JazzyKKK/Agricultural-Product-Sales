/* pages/shop/orderDetail/orderDetail.wxss 订单详情 */
.page-order-detail {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 状态卡 */
.status-card {
  background: linear-gradient(135deg, #7BC47F 0%, #5BA85F 100%);
  padding: 48rpx 40rpx;
  color: #fff;
  border-radius: 0 0 32rpx 32rpx;
}

.status-card.status-pending { background: linear-gradient(135deg, #F4A261 0%, #E8924A 100%); }
.status-card.status-shipped { background: linear-gradient(135deg, #5B9BD5 0%, #4A8AC4 100%); }
.status-card.status-done { background: linear-gradient(135deg, #999999 0%, #777777 100%); }
.status-card.status-closed { background: linear-gradient(135deg, #999999 0%, #777777 100%); }

.status-big {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.status-meta {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 收货信息 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  width: 120rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.info-link {
  color: var(--primary);
}

/* 商品明细 */
.od-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.od-item:last-child {
  border-bottom: none;
}

.od-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F2F5;
}

.od-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.od-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.od-name {
  font-size: 28rpx;
  font-weight: 500;
}

.od-spec {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

.od-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-light);
}

.od-qty {
  margin-left: 12rpx;
}

.od-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 金额 */
.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.amount-total {
  border-top: 2rpx solid var(--border);
  margin-top: 8rpx;
  font-weight: 600;
  font-size: 30rpx;
}

.amount-total .price {
  font-size: 36rpx;
}

/* 底部操作栏 */
.od-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.od-btn {
  flex: 1;
  margin: 0 8rpx;
}

.od-tip {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  color: var(--text-secondary);
  font-size: 28rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
