/* pages/shop/detail/detail.wxss 商品详情 */
.page-detail {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.detail-image-wrap {
  width: 100%;
  height: 600rpx;
  background: #F0F2F5;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail-tags {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-spec {
  font-size: 24rpx;
  color: var(--text-light);
  margin-left: 12rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.detail-price {
  font-size: 48rpx;
}

.detail-unit {
  font-size: 26rpx;
  color: var(--text-light);
  margin-left: 8rpx;
}

.detail-stock {
  font-size: 24rpx;
  color: var(--text-light);
}

.detail-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-line;
}

/* 数量选择器 */
.stepper {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 36rpx;
  color: var(--text);
}

.step-btn.disabled {
  color: var(--text-light);
}

.step-input {
  width: 100rpx;
  height: 64rpx;
  text-align: center;
  border-top: 2rpx solid var(--border);
  border-bottom: 2rpx solid var(--border);
  font-size: 28rpx;
  margin: 0 -2rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-btn {
  flex: 1;
  margin: 0 8rpx;
}

.btn-disabled {
  opacity: 0.5;
}
